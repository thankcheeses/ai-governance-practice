/**
 * Generate `src/app/palettes.css` from `src/lib/palette.ts`.
 *
 *   npm run build:palettes
 *
 * The module is the single source of truth for every hex value; this writes the
 * cascade. Keeping the colours in one place and emitting the other is the same
 * choice `scripts/build-local-fonts.mjs` makes, and for the same reason: a
 * colour maintained in both a stylesheet and a module drifts, and a drifted
 * palette looks like a rendering bug rather than a stale file.
 *
 * ## The cascade
 *
 * Specificity does the work, so block order does not matter:
 *
 *   :root                                              (0,1,0)  default
 *   :root[data-theme="dark"]                            (0,2,0)  default, dark
 *   :root[data-palette="quiz"]                          (0,2,0)  quiz, light
 *   :root[data-palette="quiz"][data-theme="dark"]       (0,3,0)  quiz, dark
 *
 * A page with both attributes always lands on the most specific block. A page
 * with neither — `global-error.tsx`, or a document the init scripts never
 * reached — gets the default palette in light, which is what it got before any
 * of this existed.
 *
 * ## Shadows
 *
 * `@theme` in globals.css declares the shadow geometry once and reads three
 * channel triples from here. They used to be a hardcoded `rgb(92 58 32)`, a
 * brown, which is invisible under a warm palette and plainly wrong under a cool
 * one. The triples are derived rather than authored: a shadow is the page's own
 * ink at low alpha, not a colour anybody should have to choose.
 */
import { writeFileSync } from "node:fs";
import { resolve } from "node:path";
import {
  cssVarName,
  DEFAULT_PALETTE,
  PALETTE_IDS,
  PALETTES,
  TOKENS,
  type Mode,
  type PaletteId,
} from "../src/lib/palette.ts";

const OUT = resolve(import.meta.dirname, "..", "src", "app", "palettes.css");
const MODES: Mode[] = ["light", "dark"];

/** `#5b3df5` -> `91 61 245`, the form `rgb(... / <alpha>)` takes. */
function channels(hex: string): string {
  const h = hex.replace("#", "");
  if (!/^[0-9a-f]{6}$/i.test(h)) {
    throw new Error(`cannot take channels of a non-hex colour: ${hex}`);
  }
  return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16)).join(" ");
}

/**
 * Dark mode's shadows are black and heavier, not a tinted version of light's.
 * A shadow is an absence of light; on a dark surface it reads only if it is
 * darker than the surface, which an ink-tinted shadow is not.
 */
const DARK_SHADOWS = [
  "--shadow-card: 0 1px 3px rgb(0 0 0 / 0.35), 0 10px 28px rgb(0 0 0 / 0.4)",
  "--shadow-card-hover: 0 2px 6px rgb(0 0 0 / 0.4), 0 14px 36px rgb(0 0 0 / 0.5)",
  "--shadow-raised: 0 1px 2px rgb(0 0 0 / 0.4), 0 4px 12px rgb(0 0 0 / 0.45)",
];

function block(selectors: string[], id: PaletteId, mode: Mode): string {
  const tokens = PALETTES[id][mode];
  const lines = TOKENS.map((t) => `  ${cssVarName(t)}: ${tokens[t]};`);

  lines.push(
    "",
    "  /* Derived: the shadow geometry in globals.css reads these. */",
    `  --shadow-rgb: ${channels(tokens.foreground)};`,
    `  --shadow-accent-rgb: ${channels(tokens.accent)};`,
    `  --shadow-inset-rgb: ${channels(tokens.card)};`,
  );
  if (mode === "dark") {
    lines.push("", ...DARK_SHADOWS.map((d) => `  ${d};`));
  }
  lines.push("", `  color-scheme: ${mode};`);

  return `${selectors.join(",\n")} {\n${lines.join("\n")}\n}`;
}

const blocks: string[] = [];

// The default palette, reachable with no attributes set at all.
blocks.push(block([":root", `:root[data-palette="${DEFAULT_PALETTE}"]`], DEFAULT_PALETTE, "light"));
blocks.push(
  block(
    [`:root[data-theme="dark"]`, `:root[data-palette="${DEFAULT_PALETTE}"][data-theme="dark"]`],
    DEFAULT_PALETTE,
    "dark",
  ),
);

for (const id of PALETTE_IDS) {
  if (id === DEFAULT_PALETTE) continue;
  blocks.push(block([`:root[data-palette="${id}"]`], id, "light"));
  blocks.push(block([`:root[data-palette="${id}"][data-theme="dark"]`], id, "dark"));
}

const header = `/*
  GENERATED by scripts/build-palette-css.mjs — do not edit.

  Every value here comes from src/lib/palette.ts. Change a colour there and run
  \`npm run build:palettes\`; src/lib/palette.test.ts fails if this file is stale.

  ${PALETTE_IDS.length} palettes x ${MODES.length} modes, ${TOKENS.length} tokens each.
*/
`;

writeFileSync(OUT, `${header}\n${blocks.join("\n\n")}\n`, "utf8");
console.log(
  `wrote src/app/palettes.css  ${PALETTE_IDS.length} palettes, ` +
    `${PALETTE_IDS.length * MODES.length} blocks, ${TOKENS.length} tokens each`,
);

# Judgment Labs — environment configuration
#
# All variables are OPTIONAL. With none of them set the app runs in local mode:
# every feature works and progress is saved in the browser. Adding Supabase
# credentials turns on accounts and cross-device sync.

# --- Supabase (optional: enables auth + progress sync) ----------------------
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Auth redirect (needed for the mobile build) ----------------------------
# Where Supabase email-confirmation links return the user. Baked in at build
# time, so the mobile bundle must point at a reachable https origin rather than
# the app scheme. Also add this URL to Supabase → Authentication → URL
# Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=

# --- Seeding only (server-side; never expose to the client) -----------------
# Used by `npm run seed` to write the question bank into the database.
SUPABASE_SERVICE_ROLE_KEY=

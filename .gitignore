# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the placeholder template is meant to be committed. Without this
# exception `.env*` ignores it, and it only stays tracked because it was
# force-added once — a `git rm --cached` would make it silently unaddable.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# capacitor native platforms (generated by `npx cap add`)
/android
/ios
